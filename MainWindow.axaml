<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:TreeSizeViewNG.ViewModels"
        xmlns:mi="using:Material.Icons.Avalonia"
        xmlns:loc="using:TreeSizeViewNG.Localization"
        x:Class="TreeSizeViewNG.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="TreeSizeViewNG"
        Icon="/Assets/app.ico"
        Width="1180"
        Height="760"
        MinWidth="900"
        MinHeight="560"
        FontSize="12"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Fine.WindowBackground}"
        Foreground="{DynamicResource Fine.TextPrimary}">

  <!-- Farben und Control-Stile: Themes/FineTheme.axaml (hell und dunkel) -->
  <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="20,14,20,16">

    <!-- Kopfzeile -->
    <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Margin="2,0,2,12">
      <Image Source="/Assets/Icon.png"
             Width="30" Height="30"
             VerticalAlignment="Center"
             RenderOptions.BitmapInterpolationMode="HighQuality" />
      <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center" Spacing="1">
        <TextBlock Text="TreeSizeViewNG" FontSize="16" FontWeight="SemiBold" />
        <TextBlock Classes="hint" Text="{x:Static loc:Strings.AppSubtitle}" />
      </StackPanel>
      <!-- Hell/Dunkel von Hand umschalten (Standard: wie das Betriebssystem) -->
      <Button Grid.Column="2"
              Padding="8,5"
              VerticalAlignment="Center"
              Click="ToggleTheme_OnClick"
              AutomationProperties.Name="{x:Static loc:Strings.ThemeToggleTip}"
              ToolTip.Tip="{x:Static loc:Strings.ThemeToggleTip}">
        <mi:MaterialIcon x:Name="ThemeIcon" Kind="WeatherNight" Width="16" Height="16" />
      </Button>
    </Grid>

    <!-- Eingaben -->
    <Border Grid.Row="1" Classes="card" Padding="14,12" Margin="0,0,0,12">
      <Grid RowDefinitions="Auto,Auto">
        <Grid ColumnDefinitions="*,Auto,Auto,Auto">
          <StackPanel>
            <TextBlock Classes="section" Text="{x:Static loc:Strings.FolderToAnalyse}" />
            <TextBox Text="{Binding FolderPath, UpdateSourceTrigger=PropertyChanged}"
                     Watermark="{x:Static loc:Strings.ChooseFolder}" />
          </StackPanel>

          <Button Grid.Column="1"
                  Margin="8,0,0,0"
                  VerticalAlignment="Bottom"
                  Padding="8,5"
                  Click="ChooseFolder_OnClick"
                  AutomationProperties.Name="{x:Static loc:Strings.ChooseFolder}"
                  ToolTip.Tip="{x:Static loc:Strings.ChooseFolder}">
            <mi:MaterialIcon Kind="FolderOpenOutline" Width="16" Height="16" />
          </Button>

          <Button Grid.Column="2"
                  Classes="primary"
                  MinWidth="96"
                  Margin="8,0,0,0"
                  VerticalAlignment="Bottom"
                  IsEnabled="{Binding CanStart}"
                  AutomationProperties.Name="{x:Static loc:Strings.Scan}"
                  Click="StartScan_OnClick">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <mi:MaterialIcon Kind="Magnify" Width="15" Height="15" />
              <TextBlock Text="{x:Static loc:Strings.Scan}" />
            </StackPanel>
          </Button>

          <Button Grid.Column="3"
                  Classes="danger"
                  MinWidth="80"
                  Margin="8,0,0,0"
                  VerticalAlignment="Bottom"
                  IsEnabled="{Binding CanStop}"
                  AutomationProperties.Name="{x:Static loc:Strings.Stop}"
                  Click="StopScan_OnClick">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <mi:MaterialIcon Kind="Stop" Width="15" Height="15" />
              <TextBlock Text="{x:Static loc:Strings.Stop}" />
            </StackPanel>
          </Button>
        </Grid>

        <Grid Grid.Row="1"
              ColumnDefinitions="2*,Auto,Auto,Auto,Auto"
              Margin="0,12,0,0">
          <StackPanel>
            <TextBlock Classes="section" Text="{x:Static loc:Strings.Search}" />
            <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                     Watermark="{x:Static loc:Strings.SearchWatermark}" />
          </StackPanel>

          <StackPanel Grid.Column="1" Margin="12,0,0,0">
            <TextBlock Classes="section" Text="{x:Static loc:Strings.MinimumSize}" />
            <NumericUpDown Width="130"
                           Minimum="0"
                           Maximum="1000000"
                           Increment="10"
                           Value="{Binding MinimumSizeMb, Mode=TwoWay}"
                           FormatString="0.##">
              <NumericUpDown.InnerRightContent>
                <TextBlock Text="MB"
                           Margin="0,0,6,0"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource Fine.TextSecondary}" />
              </NumericUpDown.InnerRightContent>
            </NumericUpDown>
          </StackPanel>

          <Button Grid.Column="2"
                  Margin="12,0,0,0"
                  VerticalAlignment="Bottom"
                  Click="ExpandAll_OnClick"
                  AutomationProperties.Name="{x:Static loc:Strings.ExpandAll}"
                  ToolTip.Tip="{x:Static loc:Strings.ExpandAllTip}">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <mi:MaterialIcon Kind="UnfoldMoreHorizontal" Width="15" Height="15" />
              <TextBlock Text="{x:Static loc:Strings.ExpandAll}" />
            </StackPanel>
          </Button>

          <Button Grid.Column="3"
                  Margin="8,0,0,0"
                  VerticalAlignment="Bottom"
                  Click="CollapseAll_OnClick"
                  AutomationProperties.Name="{x:Static loc:Strings.CollapseAll}"
                  ToolTip.Tip="{x:Static loc:Strings.CollapseAllTip}">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <mi:MaterialIcon Kind="UnfoldLessHorizontal" Width="15" Height="15" />
              <TextBlock Text="{x:Static loc:Strings.CollapseAll}" />
            </StackPanel>
          </Button>

          <TextBlock Grid.Column="4"
                     Classes="hint"
                     Margin="12,0,0,6"
                     VerticalAlignment="Bottom"
                     Text="{x:Static loc:Strings.MatchingFilesHint}" />
        </Grid>
      </Grid>
    </Border>

    <!-- Baum -->
    <Border Grid.Row="2" Classes="card" ClipToBounds="True">
      <Grid RowDefinitions="Auto,*">
        <Border Background="{DynamicResource Fine.Inset}"
                BorderBrush="{DynamicResource Fine.Divider}"
                BorderThickness="0,0,0,1"
                Padding="12,8">
          <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,*,Auto">
            <Button Classes="levelButton"
                    Content="−"
                    Click="CollapseOneLevel_OnClick"
                    IsEnabled="{Binding CanCollapseOneLevel}"
                    ToolTip.Tip="{x:Static loc:Strings.CollapseLevelTip}" />
            <Button Grid.Column="1"
                    Classes="levelButton"
                    Content="+"
                    Margin="6,0,0,0"
                    Click="ExpandOneLevel_OnClick"
                    IsEnabled="{Binding CanExpandOneLevel}"
                    ToolTip.Tip="{x:Static loc:Strings.ExpandLevelTip}" />
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="7" Margin="12,0,0,0">
              <Border Width="7" Height="7" CornerRadius="3.5"
                      Background="{DynamicResource Fine.Ok}"
                      VerticalAlignment="Center" />
              <TextBlock Text="{x:Static loc:Strings.TreeTitle}"
                         FontWeight="SemiBold"
                         VerticalAlignment="Center" />
            </StackPanel>
            <Border Grid.Column="3"
                    Margin="10,0,0,0"
                    Padding="8,2"
                    CornerRadius="999"
                    Background="{DynamicResource Fine.AccentTint}"
                    VerticalAlignment="Center">
              <StackPanel Orientation="Horizontal" Spacing="4">
                <TextBlock Text="{x:Static loc:Strings.LevelWord}"
                           FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"
                           Foreground="{DynamicResource Fine.OnSecondary}" />
                <Button Classes="levelNumber"
                        Content="{Binding CurrentLevelText}"
                        IsEnabled="{Binding CanUseLevelButtons}"
                        Click="CurrentLevel_OnClick"
                        AutomationProperties.AutomationId="CurrentLevel"
                        ToolTip.Tip="{x:Static loc:Strings.CurrentLevelTip}" />
                <TextBlock Text="/" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"
                           Foreground="{DynamicResource Fine.OnSecondary}" />
                <Button Classes="levelNumber"
                        Content="{Binding MaximumLevelText}"
                        IsEnabled="{Binding CanUseLevelButtons}"
                        Click="MaximumLevel_OnClick"
                        AutomationProperties.AutomationId="MaximumLevel"
                        ToolTip.Tip="{x:Static loc:Strings.MaximumLevelTip}" />
              </StackPanel>
            </Border>
            <TextBlock Grid.Column="5"
                       Classes="hint"
                       Foreground="{DynamicResource Fine.TextMuted}"
                       Text="{x:Static loc:Strings.SortHint}"
                       VerticalAlignment="Center" />
          </Grid>
        </Border>

        <TreeDataGrid Grid.Row="1"
                      x:Name="Tree"
                      Source="{Binding Source}"
                      BorderThickness="0"
                      Background="{DynamicResource Fine.CardBackground}"
                      CanUserResizeColumns="True"
                      DoubleTapped="Tree_OnDoubleTapped"
                      CanUserSortColumns="True" />

        <!-- Fortschritt quer über dem Baum, solange gescannt, sortiert oder aufgeklappt wird -->
        <ProgressBar Grid.Row="1"
                     Classes="busy"
                     VerticalAlignment="Top"
                     Height="4"
                     MinHeight="4"
                     CornerRadius="0"
                     Value="{Binding ProgressPercent}"
                     IsIndeterminate="{Binding IsProgressIndeterminate}"
                     IsVisible="{Binding IsBusy}" />
      </Grid>
    </Border>

    <!-- Statusleiste und Export unten rechts -->
    <Grid Grid.Row="3" ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto" Margin="0,10,0,0">
      <!-- Export-Optionen über dem Export-Button -->
      <StackPanel Grid.Row="0"
                  Grid.ColumnSpan="2"
                  Orientation="Horizontal"
                  HorizontalAlignment="Right"
                  Spacing="14"
                  Margin="0,0,0,8">
        <TextBlock Classes="hint"
                   VerticalAlignment="Center"
                   MaxWidth="420"
                   TextTrimming="CharacterEllipsis"
                   Text="{Binding ExportScopeText}"
                   ToolTip.Tip="{Binding ExportScopePath}" />
        <CheckBox Content="{x:Static loc:Strings.IncludeParentLevels}"
                  IsChecked="{Binding IncludeParentLevels}"
                  ToolTip.Tip="{x:Static loc:Strings.IncludeParentLevelsTip}" />
      </StackPanel>

      <Border Grid.Row="1"
              Background="{DynamicResource Fine.StatusBackground}"
              BorderBrush="{DynamicResource Fine.StatusBorder}"
              BorderThickness="1"
              CornerRadius="6"
              Padding="12,0"
              MinHeight="30">
        <Grid ColumnDefinitions="Auto,Auto,*">
          <ProgressBar Classes="busy"
                       Width="180"
                       Height="8"
                       MinHeight="8"
                       Margin="0,0,10,0"
                       Value="{Binding ProgressPercent}"
                       IsIndeterminate="{Binding IsProgressIndeterminate}"
                       IsVisible="{Binding IsBusy}"
                       VerticalAlignment="Center" />
          <TextBlock Grid.Column="1"
                     Classes="progress"
                     AutomationProperties.AutomationId="ProgressText"
                     Margin="0,0,12,0"
                     VerticalAlignment="Center"
                     Text="{Binding ProgressText}"
                     IsVisible="{Binding IsBusy}" />
          <TextBlock Grid.Column="2"
                     VerticalAlignment="Center"
                     Foreground="{DynamicResource Fine.TextSecondary}"
                     AutomationProperties.AutomationId="StatusText"
                     Text="{Binding StatusDisplay}"
                     TextTrimming="CharacterEllipsis" />
        </Grid>
      </Border>

      <Button Grid.Row="1"
              Grid.Column="1"
              Classes="primary"
              Margin="10,0,0,0"
              VerticalAlignment="Stretch"
              IsEnabled="{Binding CanExport}"
              Click="ExportCsv_OnClick"
              AutomationProperties.Name="{x:Static loc:Strings.ExportCsv}"
              ToolTip.Tip="{x:Static loc:Strings.ExportCsvTip}">
        <StackPanel Orientation="Horizontal" Spacing="6">
          <mi:MaterialIcon Kind="Download" Width="15" Height="15" />
          <TextBlock Text="{x:Static loc:Strings.ExportCsv}" />
        </StackPanel>
      </Button>

      <!-- Je PDM-Tresor, der gerade abgefragt wird, eine eigene Fortschrittszeile -->
      <ItemsControl Grid.Row="2" Grid.ColumnSpan="2" ItemsSource="{Binding PdmLines}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:PdmLine">
            <Border Margin="0,6,0,0"
                    Background="{DynamicResource Fine.StatusBackground}"
                    BorderBrush="{DynamicResource Fine.StatusBorder}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="12,0"
                    MinHeight="30">
              <StackPanel Orientation="Horizontal" Spacing="10">
                <ProgressBar Classes="busy" Width="180" Height="8" MinHeight="8" IsIndeterminate="True" VerticalAlignment="Center" />
                <TextBlock Classes="progress" Text="{Binding Title}" VerticalAlignment="Center" />
                <TextBlock Text="{Binding Text}" VerticalAlignment="Center" Foreground="{DynamicResource Fine.TextSecondary}" />
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </Grid>
  </Grid>
</Window>
